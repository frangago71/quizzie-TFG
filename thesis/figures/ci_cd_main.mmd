            D2["<div style='min-width:290px;'><div style='background:#111; color:#fff; padding:12px; font-size:24px; font-weight:bold; border-bottom:1px solid #aaa;'>vercel</div><div style='padding:16px; font-size:22px; line-height:1.5; text-align:left; white-space:normal;'>• Integración nativa, GitHub detecta el push a main<br/>• Compila y despliega el frontend automáticamente</div></div>"]
        end
    end

    T2 --> S1
    T2 --> D1
    T2 -.-> D2

    style S1 stroke:#55ccaa,stroke-width:2px
    style D1 stroke:#007976,stroke-width:2px
    style D2 stroke:#007976,stroke-width:2px
