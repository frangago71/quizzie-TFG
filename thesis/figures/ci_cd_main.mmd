        subgraph SQ_Inner [" "]
            S1["<div style='min-width:330px;'><div style='background:#333; color:#fff; padding:12px; font-size:24px; font-weight:bold; border-bottom:1px solid #aaa;'>sonarqube</div><div style='padding:16px; font-size:22px; line-height:1.5; text-align:left; white-space:normal;'>• Reejecuta pruebas backend para cobertura<br/>• Usa caché local para agilizar el análisis<br/>• Escanea deuda técnica, seguridad y mantenibilidad<br/>• Envía métricas consolidadas a SonarCloud</div></div>"]
