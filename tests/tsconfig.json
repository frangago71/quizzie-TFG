{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "typeRoots": [
      "../frontend/node_modules/@types",
      "../frontend/node_modules"
    ],
    "types": [
      "node",
      "vite/client",
      "vitest/globals",
      "@testing-library/jest-dom",
      "react",
      "react-dom"
    ],
    "baseUrl": "../frontend",
    "paths": {
      "@/*": ["src/*"],
      "*": ["node_modules/*", "*"]
    }
  },
  "include": [
    "**/*"
  ]
}
