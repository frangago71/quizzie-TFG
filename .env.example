# QUIZZIE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)

# Copy this file to '.env' and fill in your actual configurations.

# FRONTEND CONFIGURATION
VITE_API_URL=http://localhost:8000  # The API URL endpoint of the FastAPI backend.
# NOTES:
# 1. Local development: http://localhost:8000
# 2. Production/deployment: The URL of your backend hosted on Render/etc.

# JWT AUTHENTICATION CONFIGURATION
SECRET_KEY=                             # A secret key used to sign JWT tokens.
ALGORITHM=HS256                         # The algorithm used to sign the JWT tokens. Default: HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30          # Token expiration time in minutes. Default: 30

# SMTP EMAIL CONFIGURATION
SMTP_HOST=smtp.gmail.com    # The hostname of your SMTP email server. Default: smtp.gmail.com
SMTP_PORT=                  # The port used by your SMTP server. Default: 465 (SSL) or 587 (TLS/STARTTLS)
SMTP_USERNAME=              # The email address or username used to authenticate with SMTP.
SMTP_PASSWORD=              # The authentication password or API key.
SMTP_FROM=                  # The email address that will appear in the "From" header of sent messages.
# NOTES:
# 1. For GMAIL password: Use Google "App Password" (without spaces)
# 2. If you leave SMTP_FROM empty, it will be the same as SMTP_USERNAME
# 3. For Gmail SMTP, this must match SMTP_USERNAME exactly.
